# Set a strong value before exposing the app beyond this computer.
APP_ACCESS_KEY=change-me
COOKIE_SECURE=false

# 127.0.0.1: this computer only.
# Set a specific LAN/VPN address to open the UI from your own phone or tablet.
# Avoid 0.0.0.0 unless the host firewall and access key are configured.
APP_BIND_ADDRESS=127.0.0.1

MAX_PLAYLIST_ITEMS=50
MAX_VIDEO_DURATION_SECONDS=14400
MAX_SOURCE_MEGABYTES=4096
MIN_FREE_GIGABYTES=2
MAX_RETAINED_JOBS=6
JOB_TTL_HOURS=24

SCAN_TIMEOUT_SECONDS=180
DOWNLOAD_TIMEOUT_SECONDS=7200
TRANSCODE_TIMEOUT_SECONDS=21600

# Optional experimental PO-token provider settings. Docker Compose supplies
# these only when docker-compose.pot.yml is explicitly enabled.
# POT_PROVIDER_URL=http://pot-provider:4416
# YOUTUBE_PLAYER_CLIENT=mweb
